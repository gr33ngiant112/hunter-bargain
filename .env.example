# Environment Configuration for hunter-bargain
# Copy this file to .env. Its values are for development: alerts go to Mailpit, the local test
# mail server that `docker compose --profile dev up` starts, and there is no SerpAPI key. Real
# credentials go in a file outside the checkout that HB_ENV_FILE names (README "Deployment"),
# so nothing run in the checkout (pytest, uvicorn, a coding agent) loads them.

# --- Database ---
DATABASE_URL=sqlite:///./data/hunter_bargain.db

# --- Scheduling ---
# Cron expression for daily price checks, in PRICE_CHECK_TZ (default: 9:00 AM UTC)
PRICE_CHECK_CRON=0 9 * * *
# IANA time zone for PRICE_CHECK_CRON, e.g. America/New_York
PRICE_CHECK_TZ=UTC

# --- Email (SMTP) ---
# Mailpit's inbox is at http://127.0.0.1:8025. For the app run on the host (uvicorn), use
# SMTP_HOST=127.0.0.1. Real email, in the HB_ENV_FILE file: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_SECURITY=tls, SMTP_USER, SMTP_PASSWORD (e.g. a Gmail app password).
SMTP_HOST=mailpit
# With SMTP_SECURITY=tls, 465 uses implicit TLS and other ports use STARTTLS.
SMTP_PORT=1025
# tls (the default): TLS that verifies the server certificate, then a login with SMTP_USER and
# SMTP_PASSWORD. none: no TLS and no login, for a local test server such as Mailpit only.
SMTP_SECURITY=none
SMTP_TIMEOUT=30
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=hunter-bargain@localhost
# Comma-separated addresses that may receive alerts, e.g. me@example.com,you@example.com
# (case is ignored for plain ASCII addresses). An item's notify_email must be one of them,
# otherwise the API returns 422. Unset allows no address; an invalid entry stops the app
# at startup.
ALERT_RECIPIENTS=you@example.com

# --- Search Engines ---
# SerpAPI key (https://serpapi.com/), required for Google/Bing Shopping searches. Empty here: the
# real key goes in the HB_ENV_FILE file.
SERPAPI_KEY=

# --- Application ---
# Host address docker compose publishes the API on. 127.0.0.1 (the default) keeps it on this
# machine; 0.0.0.0 or this host's LAN address makes it reachable from your network. The API
# has no authentication of its own, so only do that on a network you trust.
HB_BIND_ADDR=127.0.0.1
# Host port docker compose publishes the API on; the container itself listens on 8000.
APP_PORT=8000
# File docker compose passes to the app as its settings; the default is this .env. Point it
# at a file outside the checkout that holds the real credentials (README "Deployment").
# Compose reads HB_ENV_FILE, HB_BIND_ADDR and APP_PORT only from this .env or the shell.
# HB_ENV_FILE=~/.config/hunter-bargain/hb.env
LOG_LEVEL=info
