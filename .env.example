# Environment Configuration for hunter-bargain
# Copy this file to .env and fill in your values.

# --- Database ---
DATABASE_URL=sqlite:///./data/hunter_bargain.db

# --- Scheduling ---
# Cron expression for daily price checks, in PRICE_CHECK_TZ (default: 9:00 AM UTC)
PRICE_CHECK_CRON=0 9 * * *
# IANA time zone for PRICE_CHECK_CRON, e.g. America/New_York
PRICE_CHECK_TZ=UTC

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
# 465 uses implicit TLS; other ports use STARTTLS. Both verify the server certificate.
SMTP_PORT=587
SMTP_TIMEOUT=30
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
# Comma-separated addresses that may receive alerts, e.g. me@example.com,you@example.com
# (case is ignored for plain ASCII addresses). An item's notify_email must be one of them,
# otherwise the API returns 422. Unset allows no address; an invalid entry stops the app
# at startup.
ALERT_RECIPIENTS=your-email@gmail.com

# --- Search Engines ---
# SerpAPI key (https://serpapi.com/) — required for Google/Bing Shopping searches
SERPAPI_KEY=your-serpapi-key

# --- Application ---
# Host address docker compose publishes the API on. 127.0.0.1 (the default) keeps it on this
# machine; 0.0.0.0 or this host's LAN address makes it reachable from your network. The API
# has no authentication of its own, so only do that on a network you trust.
HB_BIND_ADDR=127.0.0.1
# Host port docker compose publishes the API on; the container itself listens on 8000.
APP_PORT=8000
# File docker compose passes to the app as its settings; the default is this .env. Point it
# at a file outside the checkout that holds the real credentials (README "Deployment").
# Compose reads HB_ENV_FILE, HB_BIND_ADDR and APP_PORT only from this .env or the shell.
# HB_ENV_FILE=~/.config/hunter-bargain/hb.env
LOG_LEVEL=info
