# Environment Configuration for hunter-bargain
# Copy this file to .env and fill in your values.

# --- Database ---
DATABASE_URL=sqlite:///./data/hunter_bargain.db

# --- Scheduling ---
# Cron expression for daily price checks (default: 9:00 AM UTC)
PRICE_CHECK_CRON=0 9 * * *

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# --- Search Engines ---
# SerpAPI key (https://serpapi.com/) — required for Google/Bing Shopping searches
SERPAPI_KEY=your-serpapi-key

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
